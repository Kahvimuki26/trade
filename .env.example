# Only needed for `data_source: alpaca` / `--source alpaca`.
# Free paper account: https://app.alpaca.markets  -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex = free real-time feed (one exchange). sip = full market; the free plan
# can use it for history older than 15 minutes, which is great for backtests.
ALPACA_DATA_FEED=iex

# Extra paper accounts for more `broker: alpaca` instances (alpaca_account: two)
# ALPACA_TWO_API_KEY=
# ALPACA_TWO_SECRET_KEY=

# Dashboard login. REQUIRED before putting it online (Cloudflare Tunnel).
# Any username + this password. Leave empty for local-only use.
TRADEBOT_PASSWORD=
