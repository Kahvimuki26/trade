# Copy this file to .env to change settings.

# Needed for the "Claude AI" trader. Create a key at console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Dashboard port (default 8765). If it's busy, the next free one is used.
# TRADEBOT_PORT=8765

# Dashboard login. REQUIRED before putting it online (e.g. a Cloudflare Tunnel).
# Any username + this password. Leave empty for use on this computer only.
TRADEBOT_PASSWORD=
